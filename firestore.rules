rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // 관리자 명단: 콘솔에서 관리자 uid로 빈 문서 생성. 본인 문서만 읽기, 쓰기는 콘솔에서만.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 글 번호 카운터: 로그인 유저가 정확히 +1 만 가능(글 작성 트랜잭션에서만 건드림)
    match /counters/posts {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq == (resource == null ? 0 : resource.data.seq) + 1;
    }

    // 상영작 추천: 로그인 유저가 본인 명의로 생성, 읽기/삭제는 관리자만. 수정 없음
    match /suggestions/{id} {
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 안내 페이지(소개/행사정보/티켓팅) 본문: 누구나 읽기, 관리자만 수정
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.board in ['free', 'review', 'notice']
        && (request.resource.data.board != 'notice' || isAdmin());

      allow update, delete: if isOwner(resource.data.authorUid) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isOwner(resource.data.authorUid) || isAdmin();
        allow update: if false;
      }
    }
  }
}
